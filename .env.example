# Clerk (authentication — Expo SDK + Next.js)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Supabase (PostgreSQL + storage)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Plant identification API (choose one; keep the key server-side only)
PLANTNET_ID_API_KEY=
PLANTNET_API_URL=
# PLANTNET_API_KEY=xxxxxxxx
# PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all

# Next.js API
API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=
# Optional: Expo project ID from app.json extra.eas.projectId
EXPO_PUBLIC_PROJECT_ID=xxxxxxxx

# App metadata
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_SUPPORT_EMAIL=support@leafcare.app
