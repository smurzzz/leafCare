# Clerk (authentication — Expo SDK + Next.js)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Supabase (PostgreSQL + storage)
EXPO_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=plant-photos
# Only needed if you enable direct storage reads; the API signs photo URLs.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Plant identification (server only — these must never reach the app bundle)
# Plant.id is preferred:
# PLANT_ID_API_KEY=xxxxxxxx
# PLANT_ID_API_URL=https://api.plant.id/v3/identification
# PlantNet fallback:
# PLANTNET_API_KEY=xxxxxxxx
# PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
# `mock` keeps the capture → identify → add flow working with no vendor key.
IDENTIFY_PROVIDER=mock

# Next.js API (the app reads EXPO_PUBLIC_API_BASE_URL)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=

# Reminder cron endpoint auth
CRON_SECRET=change-me

# Mobile app origin, used for CORS + Clerk authorized parties
APP_ORIGIN=http://localhost:8081
# Optional: Expo project ID from app.json extra.eas.projectId
EXPO_PUBLIC_PROJECT_ID=xxxxxxxx

# App metadata
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_SUPPORT_EMAIL=support@leafcare.app
