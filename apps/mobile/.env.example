# Copy to apps/mobile/.env

# Clerk (publishable key only — never a secret key in the app bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Next.js API
# Physical device: use your machine's LAN IP or a tunnel, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase (only needed if you enable direct storage reads; the API signs URLs)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App metadata
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_SUPPORT_EMAIL=support@leafcare.app
# Optional: Expo project id for push notifications
EXPO_PUBLIC_PROJECT_ID=
