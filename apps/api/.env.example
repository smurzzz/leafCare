# Copy to apps/api/.env.local

# Clerk (server only)
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# The Clerk dashboard issues this as CLERK_WEBHOOK_SIGNING_SECRET; the webhook
# route accepts either name.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional: skip JWKS fetching by pasting the instance JWT public key
# CLERK_JWT_KEY=

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx
SUPABASE_PHOTO_BUCKET=plant-photos

# Plant identification (server only)
# PLANT_ID_API_KEY=xxxxxxxx
# PLANT_ID_API_URL=https://api.plant.id/v3/identification
# PLANTNET_API_KEY=xxxxxxxx
# PLANTNET_API_URL=https://my-api.plantnet.org/v2/identify/all
# `mock` keeps the whole identify flow working without a vendor key.
IDENTIFY_PROVIDER=mock

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=

# Job auth for the reminder cron endpoint
CRON_SECRET=change-me

# Where the mobile app is served from, used for CORS + authorized parties
APP_ORIGIN=http://localhost:8081
